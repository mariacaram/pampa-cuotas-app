# Copiá este archivo como .env.local y completá con los datos de tu proyecto Supabase.
# (.env.local está ignorado por git — nunca se sube)

# Project URL: Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key: Supabase -> Project Settings -> API Keys -> service_role (secreta)
# OJO: es secreta, solo se usa del lado del servidor. No la compartas.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
