# Copiá este archivo como .env.local y completá con los datos de tu proyecto Supabase.
# (.env.local está ignorado por git — nunca se sube)

# --- Datos (servidor) ---
# Project URL: Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role / Secret key: Supabase -> Project Settings -> API Keys (secreta, solo servidor)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Login con Google (opcional; si no se ponen, la app queda abierta sin login) ---
# APP_AUTH_SECRET: secreto para firmar la sesión (una cadena larga y aleatoria).
APP_AUTH_SECRET=pon_aca_una_cadena_larga_y_aleatoria
# Credenciales del cliente OAuth creado en Google Cloud Console.
# Redirect URI autorizada: https://TU-DOMINIO/api/auth/google/callback (+ http://localhost:3000/... para pruebas)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
