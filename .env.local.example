# Copiá este archivo como .env.local y completá con los datos de tu proyecto Supabase.
# (.env.local está ignorado por git — nunca se sube)

# --- Datos (servidor) ---
# Project URL: Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role / Secret key: Supabase -> Project Settings -> API Keys (secreta, solo servidor)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Login con Google (opcional; si no se ponen, la app queda abierta sin login) ---
# Mismos que arriba pero públicos (van al navegador):
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable / anon key: Supabase -> Project Settings -> API Keys -> Publishable
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
